# MCP_OAUTH_SIGNING_ALGORITHM=RS256
PLUGGY_HTTP_TIMEOUT_SECONDS=45
PLUGGY_API_KEY_REFRESH_MARGIN_SECONDS=900
SEMANTIC_MAX_PAGES=10
SEMANTIC_MAX_RECORDS=2000
MAX_RESPONSE_BYTES=2000000
PORT=8080
