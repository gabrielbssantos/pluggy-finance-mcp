PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_SYNC_POLL_INTERVAL_SECONDS=3
PLUGGY_SYNC_TIMEOUT_SECONDS=120
MCP_TRANSPORT=stdio
MCP_AUTH_MODE=local_process
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
